# Copy this file to .env.local and fill in real values from your Supabase
# project's Settings → API page. Never commit .env.local (it's gitignored).
#
# These are read at BUILD TIME by Vite (import.meta.env.VITE_*) and become
# part of the published JS bundle — so only put the public "anon" key here,
# never the "service_role" key. The anon key is safe to expose client-side
# because Supabase Row Level Security (RLS) policies control what it can
# actually read/write — see docs/ADMIN_CMS_ARCHITECTURE.md.
#
# If these are left blank, the site falls back to src/data/profile.js for
# all content — see src/lib/supabase.js and
# src/lib/content/fetchWithFallback.js. Nothing breaks without them.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
